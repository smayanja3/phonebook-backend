<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Phonebook</title>
</head>

<body>
  <h1>Phonebook</h1>

  <ul>
    <% persons.forEach(person=> { %>
      <li>
        <%= person.name %>
          <%= person.number %>
      </li>
      <% }) %>
  </ul>
</body>

</html>
