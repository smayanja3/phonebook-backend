<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Log in</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <h1>Log in</h1>

  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <form action="/login" method="POST">
    <div>Username: <input type="text" name="username" autocomplete="username" required></div>
    <div>Password: <input type="password" name="password" autocomplete="current-password" required></div>
    <button type="submit">Log in</button>
  </form>

  <p>No account? <a href="/register">Register</a></p>
</body>
</html>