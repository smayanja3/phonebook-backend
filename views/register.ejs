<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <h1>Register</h1>

  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <form action="/register" method="POST">
    <div>Username: <input type="text" name="username" autocomplete="username" required></div>
    <div>Password: <input type="password" name="password" autocomplete="new-password" required> (8+ characters)</div>
    <button type="submit">Create account</button>
  </form>

  <p>Already registered? <a href="/login">Log in</a></p>
</body>
</html>